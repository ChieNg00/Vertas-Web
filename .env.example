# .env.example

# ⚠️ XÁC NHẬN TRƯỚC KHI GO-LIVE: Số hotline công khai & Zalo hỗ trợ kỹ thuật
NEXT_PUBLIC_HOTLINE_PHONE="0966200378"
NEXT_PUBLIC_ZALO_PHONE="0966200378"

# Server-side Flag: Kiểm soát hiển thị sản phẩm mẫu (Prototype)
# Mặc định "false" để ẩn hoàn toàn trên production. Đổi thành "true" khi chạy staging.
SHOW_PROTOTYPES="false"

NEXT_PUBLIC_APP_ENV="development"

# Thêm vào .env.example
# URL Webhook nhận thông báo Lead B2B (Telegram Bot, Google Sheet Webhook, Discord hoặc Slack)
LEAD_WEBHOOK_URL=""

# Email nhận thông báo kỹ thuật (nếu tích hợp Resend / Email Service)
ENGINEERING_NOTIFICATION_EMAIL="info@vertas.vn"