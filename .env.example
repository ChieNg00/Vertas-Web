# .env.example

# Kênh liên hệ kỹ thuật hiển thị trên website (bắt buộc xác nhận trước khi go-live)
NEXT_PUBLIC_HOTLINE_PHONE="0966200378"
NEXT_PUBLIC_ZALO_PHONE="0966200378"

# URL Webhook tiếp nhận Lead B2B (tương thích: Discord Webhook, Slack Incoming Webhook, Google Apps Script Web App)
# Trên Production: Bắt buộc cấu hình. Nếu bỏ trống, API sẽ chặn gửi và báo lỗi fail-closed.
LEAD_WEBHOOK_URL=""

# Cờ kiểm soát dữ liệu mẫu R&D (Fail-safe: mặc định "false" trên production)
SHOW_PROTOTYPES="false"

NEXT_PUBLIC_APP_ENV="development"