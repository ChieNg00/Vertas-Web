# .env.example

# ⚠️ QUYẾT ĐỊNH TRƯỚC KHI DEPLOY PRODUCTION:
# Hai số dưới đây hiện lấy tạm từ số điện thoại đăng ký kinh doanh theo MST (0966200378).
# Bắt buộc xác nhận trước khi go-live: Đây là hotline công khai hay cần số kỹ thuật/CSKH riêng?
NEXT_PUBLIC_HOTLINE_PHONE="0966200378"
NEXT_PUBLIC_ZALO_PHONE="0966200378"

# Điều khiển hiển thị sản phẩm mẫu (Fail-safe: mặc định ẩn trên production)
# Chỉ đặt "true" tại môi trường test/staging/review
NEXT_PUBLIC_SHOW_PROTOTYPES="false"

NEXT_PUBLIC_APP_ENV="development"